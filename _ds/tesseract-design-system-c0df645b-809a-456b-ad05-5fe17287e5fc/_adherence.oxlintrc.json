{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/slide-parts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|muted)$/]",
        "message": "<BulletList> tone must be one of 'primary' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiamondBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|style|key|ref|className|style|children)$/]",
        "message": "<DiamondBadge> doesn't accept that prop. Declared props: src, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:label|strong)$/]",
        "message": "<Eyebrow> tone must be one of 'label' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|style|key|ref|className|style|children)$/]",
        "message": "<FeatureRow> doesn't accept that prop. Declared props: icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|children|emphasis|style|key|ref|className|style|children)$/]",
        "message": "<InfoCard> doesn't accept that prop. Declared props: kicker, title, children, emphasis, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|role|bio|size|style|key|ref|className|style|children)$/]",
        "message": "<PersonCard> doesn't accept that prop. Declared props: photo, name, role, bio, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|height|style|key|ref|className|style|children)$/]",
        "message": "<SlideHeader> doesn't accept that prop. Declared props: src, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPair'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|now|next|style|key|ref|className|style|children)$/]",
        "message": "<StatusPair> doesn't accept that prop. Declared props: label, now, next, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
